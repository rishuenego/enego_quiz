{
  "name": "Enego-quiz",
  "version": "1.0.0",
  "description": "Enego Quiz Application - Monorepo",
  "main": "index.js",
  "engines": {
    "node": "15.7.0",
    "npm": "6.13.4"
  },
  "scripts": {
    "start:backend": "npm start --prefix \"backend files\"",
    "start:frontend": "npm start --prefix \"frontend files\"",
    "dev:backend": "npm run dev --prefix \"backend files\"",
    "dev:frontend": "npm start --prefix \"frontend files\"",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "install:all": "npm install --prefix \"backend files\" && npm install --prefix \"frontend files\"",
    "build:frontend": "npm run build --prefix \"frontend files\"",
    "heroku-postbuild": "npm run install:all && npm run build:frontend"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
